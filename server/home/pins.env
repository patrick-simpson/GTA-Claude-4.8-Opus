# The exact programs the home computer downloads, and the SHA-256 each must have. update.sh reads
# this file (NAME=value lines only) and refuses a download that does not match.
# To move to a newer one: change the version AND the checksum together, from the publisher's own list.
#   Node:        https://nodejs.org/dist/v<version>/SHASUMS256.txt   (the node-v<version>-linux-x64.tar.xz line)
#   cloudflared: https://pkg.cloudflare.com/cloudflared/dists/any/main/binary-amd64/Packages   (the SHA256 of cloudflared_<version>_amd64.deb)
#   ws:          sha256sum of https://registry.npmjs.org/ws/-/ws-<version>.tgz
# Cloudflare stops serving cloudflared versions older than about a year: raise CLOUDFLARED_VERSION at least twice a year.
NODE_VERSION=24.22.3
NODE_SHA256=4f2b175a6d53a5c617a80dba2676238a0688cef28c6da4eba35c7d844e66fcfb
CLOUDFLARED_VERSION=2026.11.1
CLOUDFLARED_SHA256=744ce90be92adb361103d51c85f78646314c47e4a68bbaadfe12ab5acc16c9b6
WS_VERSION=8.21.0
WS_SHA256=d08b726b3aae3a0fed5218a0d9a4b2ac8d75d4ad453a9271db55fe38e94eb4cf
